# Fechamento automático de leilões: duração (formato aceito por
# time.ParseDuration, ex: 20s, 5m, 1h). Depois desse tempo o leilão é
# fechado sozinho (status Closed) por uma goroutine, sem ação manual.
AUCTION_DURATION=5m

# Mesma duração usada pelo lado do lance (create_bid.go) para saber se um
# leilão ainda está aberto antes de aceitar o bid. Mantenha igual a
# AUCTION_DURATION para o comportamento ficar consistente (veja o README).
AUCTION_INTERVAL=5m

# Inserção de lances em lote (já existia na base do projeto)
BATCH_INSERT_INTERVAL=20s
MAX_BATCH_SIZE=4

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGODB_URL=mongodb://admin:admin@mongodb:27017/auctions?authSource=admin
MONGODB_DB=auctions
